+// ProjectSpolia: os pacotes (.pck, sempre abertos sem mágica) não usam o AES
+// puro da Godot. A chave do preset vira duas por SHA-256 com sais secretos; o
+// conteúdo passa por um fluxo AES-OFB com a segunda chave e depois pelo CFB
+// com a primeira, com o IV gravado misturado a um tempero; o cabeçalho troca a
+// ordem e esconde o tamanho. FileAccess::open_encrypted segue o formato padrão.
+
+void FileAccessEncrypted::_spolia_derivar(const Vector<uint8_t> &p_key) {
+	uint8_t buf[96];
+	memcpy(buf, SPOLIA_SAL_CFB, 32);
+	memcpy(buf + 32, p_key.ptr(), 32);
+	memcpy(buf + 64, SPOLIA_SAL_OFB, 32);
+	key.resize(32);
+	CryptoCore::sha256(buf, 64, key.ptrw());
+	key_ofb.resize(32);
+	CryptoCore::sha256(buf + 32, 64, key_ofb.ptrw());
+	memset(buf, 0, sizeof(buf));
+}
+
+void FileAccessEncrypted::_spolia_iv(uint8_t r_iv[16]) const {
+	for (int i = 0; i < 16; i++) {
+		r_iv[i] = iv[i] ^ SPOLIA_TEMPERO_IV[i];
+	}
+}
+
+Error FileAccessEncrypted::_spolia_ofb(uint8_t *r_data, uint64_t p_len, const uint8_t p_iv[16]) const {
+	// CFB sobre zeros devolve o fluxo do OFB; p_len é múltiplo de 16.
+	constexpr uint64_t BLOCO = 65536;
+	uint8_t estado[16];
+	for (int i = 0; i < 16; i++) {
+		estado[i] = p_iv[15 - i];
+	}
+	CryptoCore::AESContext ctx;
+	ctx.set_encode_key((uint8_t *)key_ofb.ptr(), 256);
+	LocalVector<uint8_t> fluxo;
+	fluxo.resize(MIN(p_len, BLOCO));
+	for (uint64_t ofs = 0; ofs < p_len; ofs += BLOCO) {
+		uint64_t n = MIN(BLOCO, p_len - ofs);
+		memset(fluxo.ptr(), 0, n);
+		Error err = ctx.encrypt_cfb(n, estado, fluxo.ptr(), fluxo.ptr());
+		ERR_FAIL_COND_V(err != OK, err);
+		for (uint64_t i = 0; i < n; i++) {
+			r_data[ofs + i] ^= fluxo[i];
+		}
+	}
+	return OK;
+}
